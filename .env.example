# Copy to .env.local for local development. Never commit real values.
# Server-only key for the optional "Try your own" generator (Google AI Studio). Leave empty to disable it.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.5-flash-lite (fastest). Check speed with: node scripts/gemini-check.mjs
GEMINI_MODEL=
# Optional ceiling on generations per server instance per day; defaults to 200.
GENERATE_DAILY_CAP=
